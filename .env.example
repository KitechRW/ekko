# Export these into the Node process. The app does not auto-load .env files.
PORT=3000
# At least 12 characters; do not reuse a password.
EKKO_ADMIN_PASSWORD=
# At least 32 random characters; keep private.
EKKO_SESSION_SECRET=
# Public-facing HTTPS origin when deployed.
EKKO_PUBLIC_ORIGIN=
# Optional: absolute path on persistent writable disk.
EKKO_DATA_FILE=
NODE_ENV=development
